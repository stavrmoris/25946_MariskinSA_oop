DOXYFILE_ENCODING = UTF-8
PROJECT_NAME = "Роботы — семинар 12"
PROJECT_NUMBER = 1.0
OUTPUT_LANGUAGE = Russian
OUTPUT_DIRECTORY = "@CMAKE_CURRENT_BINARY_DIR@/docs"
INPUT = "@CMAKE_CURRENT_SOURCE_DIR@/robot.h" "@CMAKE_CURRENT_SOURCE_DIR@/robot.cpp"
INPUT_ENCODING = UTF-8
RECURSIVE = NO
EXTRACT_ALL = NO
EXTRACT_PRIVATE = YES
WARN_IF_UNDOCUMENTED = YES
WARN_IF_DOC_ERROR = YES
WARN_AS_ERROR = YES
QUIET = YES
GENERATE_HTML = YES
GENERATE_LATEX = NO
GENERATE_XML = YES
HAVE_DOT = YES
DOT_PATH = "@DOXYGEN_DOT_PATH@"
CLASS_GRAPH = YES
COLLABORATION_GRAPH = YES
DOT_IMAGE_FORMAT = svg
INTERACTIVE_SVG = NO
